.inventory-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; background: #f5f6fa; }
.form-card { padding: 28rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.form-title { font-size: 30rpx; font-weight: 700; color: #333; margin-bottom: 20rpx; }
.name-input, .small-input, .date-picker { box-sizing: border-box; height: 72rpx; border: 1rpx solid #eceef2; border-radius: 12rpx; background: #fafbfc; font-size: 26rpx; color: #333; }
.name-input { width: 100%; padding: 0 20rpx; }
.form-row { display: flex; gap: 12rpx; margin-top: 14rpx; }
.small-input { width: 150rpx; padding: 0 16rpx; }
.unit-input { width: 180rpx; }
.date-picker { width: 100%; padding: 0 14rpx; line-height: 70rpx; color: #aaa; font-size: 23rpx; }
.date-picker.has-value { color: #555; }
.add-btn { margin-top: 20rpx; padding: 18rpx 0; border-radius: 38rpx; text-align: center; color: #fff; font-size: 28rpx; font-weight: 600; background: linear-gradient(135deg, #ff6b35, #ff4500); }
.list-title { margin: 30rpx 8rpx 16rpx; font-size: 30rpx; font-weight: 700; color: #333; }
.list-title text { margin-left: 10rpx; font-size: 23rpx; font-weight: 400; color: #999; }
.inventory-item { margin-bottom: 16rpx; padding: 24rpx; border-radius: 18rpx; background: #fff; }
.item-main, .item-bottom { display: flex; align-items: center; justify-content: space-between; }
.item-name { font-size: 30rpx; font-weight: 600; color: #333; }
.expiry-tag { padding: 5rpx 13rpx; border-radius: 16rpx; font-size: 22rpx; }
.expiry-tag.expired { color: #d63031; background: #ffebee; }.expiry-tag.expiring { color: #e67e22; background: #fff3e0; }.expiry-tag.normal { color: #299860; background: #e8f7ee; }.expiry-tag.no-expiry { color: #888; background: #f1f3f5; }
.item-bottom { margin-top: 20rpx; }
.quantity-control { display: flex; align-items: center; gap: 16rpx; }.qty-btn { width: 46rpx; height: 46rpx; line-height: 42rpx; text-align: center; border-radius: 12rpx; background: #f0f1f4; font-size: 32rpx; color: #666; }.qty-btn.plus { color: #fff; background: #ff6b35; }.quantity { min-width: 90rpx; text-align: center; font-size: 26rpx; color: #555; }.delete-btn { font-size: 23rpx; color: #e74c3c; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; font-size: 27rpx; color: #999; }.empty-icon { margin-bottom: 20rpx; font-size: 100rpx; }
