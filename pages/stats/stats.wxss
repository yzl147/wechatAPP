.stats-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; background: #f5f6fa; }.hero-card { padding: 34rpx 30rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(135deg, #ff8a5c, #ff5b2d); }.hero-month { display: block; font-size: 38rpx; font-weight: 800; }.hero-text { display: block; margin-top: 12rpx; font-size: 23rpx; opacity: .88; }.section-title { margin: 30rpx 8rpx 16rpx; font-size: 30rpx; font-weight: 700; color: #333; }.metric-row { display: flex; gap: 16rpx; }.metric-card { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 28rpx 16rpx; border-radius: 18rpx; color: #888; font-size: 23rpx; background: #fff; }.metric-num { margin-bottom: 8rpx; color: #ff6b35; font-size: 46rpx; font-weight: 800; }.panel { padding: 10rpx 24rpx; border-radius: 18rpx; background: #fff; }.empty-panel { padding: 38rpx 24rpx; text-align: center; color: #aaa; font-size: 25rpx; }.dish-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f3f3f3; }.dish-row:last-child { border-bottom: none; }.dish-rank { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; color: #fff; font-size: 22rpx; background: #ff8a5c; }.dish-name { flex: 1; margin-left: 16rpx; color: #444; font-size: 28rpx; }.dish-count { color: #999; font-size: 23rpx; }.reminder-panel { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; padding: 24rpx; }.reminder-title { display: block; color: #444; font-size: 28rpx; font-weight: 600; }.reminder-tip { display: block; margin-top: 8rpx; color: #999; font-size: 22rpx; }.reminder-num { color: #4d7caf; font-size: 34rpx; font-weight: 800; }.reminder-num.warn { color: #e67e22; }
