.home-page { min-height: 100vh; box-sizing: border-box; padding: 42rpx 24rpx; background: #f5f6fa; }.hero { padding: 16rpx 12rpx 44rpx; }.hero-title { display: block; font-size: 48rpx; font-weight: 800; color: #262638; letter-spacing: 2rpx; }.hero-subtitle { display: block; margin-top: 14rpx; font-size: 25rpx; line-height: 1.6; color: #8a8c96; }.section-title { margin: 0 8rpx 18rpx; font-size: 30rpx; font-weight: 700; color: #333; }.scene-card { display: flex; align-items: center; margin-bottom: 18rpx; padding: 30rpx 26rpx; border-radius: 24rpx; box-shadow: 0 5rpx 20rpx rgba(0,0,0,.05); }.meal-card { background: linear-gradient(135deg, #fff0e9, #fff8f4); }.life-card { background: linear-gradient(135deg, #edf5ff, #f6f9ff); }.scene-icon { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 24rpx; background: rgba(255,255,255,.76); font-size: 46rpx; }.scene-content { min-width: 0; flex: 1; margin-left: 22rpx; }.scene-title { display: block; font-size: 34rpx; font-weight: 700; color: #333; }.scene-desc { display: block; margin-top: 8rpx; font-size: 23rpx; color: #777; }.scene-status { display: block; margin-top: 14rpx; font-size: 23rpx; color: #ff6b35; }.life-card .scene-status { color: #5182bb; }.scene-arrow { margin-left: 10rpx; font-size: 46rpx; color: #b8b8b8; }.record-entry, .stats-entry { display: flex; justify-content: space-between; padding: 24rpx; border-radius: 16rpx; color: #666; font-size: 27rpx; background: #fff; }.record-entry { margin-top: 34rpx; }.stats-entry { margin-top: 14rpx; color: #4e7dae; background: #eef5ff; }
