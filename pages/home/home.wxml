<view class="home-page">
  <view class="hero">
    <text class="hero-title">记事微清单</text>
    <text class="hero-subtitle">把日常琐事，整理成轻松可完成的清单</text>
  </view>

  <view class="decision-entry-wrap">
    <app-card variant="meal" interactive bind:tap="goToMealRoulette">
      <view class="decision-entry" aria-role="button" aria-label="不知道吃什么，进入今天吃什么转盘">
        <view class="decision-symbol">转</view>
        <view class="decision-copy">
          <text class="decision-title">不知道吃什么？转一下</text>
          <text class="decision-description">堂食、外卖、自己做，帮你快速做决定</text>
        </view>
        <view class="decision-arrow" aria-hidden="true">›</view>
      </view>
    </app-card>
  </view>

  <view class="section-title">今天要做什么</view>
  <scene-card
    tone="meal"
    symbol="饮"
    title="饮食清单"
    description="选菜、准备食材、记录今天吃什么"
    status="{{mealStatusText}}"
    loadStatus="{{mealLoadStatus}}"
    bind:tap="goToMealList"
    bind:retry="retryMealOverview"
  />
  <scene-card
    tone="life"
    symbol="事"
    title="生活清单"
    description="家务、出行和属于自己的日常待办"
    status="{{lifeStatusText}}"
    loadStatus="{{lifeLoadStatus}}"
    bind:tap="goToLifeLists"
    bind:retry="retryLifeOverview"
  />

  <view class="quick-links">
    <app-card interactive bind:tap="goToRecords">
      <view class="quick-entry"><text class="quick-symbol">记</text><text class="quick-label">回顾饮食记录</text><text class="quick-arrow">›</text></view>
    </app-card>
    <app-card variant="life" interactive bind:tap="goToStats">
      <view class="quick-entry"><text class="quick-symbol quick-symbol--life">月</text><text class="quick-label">查看本月回顾</text><text class="quick-arrow">›</text></view>
    </app-card>
  </view>
</view>
