<view class="trash-page">
  <view class="page-intro">
    <text class="page-title">最近删除</text>
    <text class="page-description">删除的饮食记录会保留在这里，可逐条恢复。当前不会自动清理。</text>
  </view>

  <loading-state wx:if="{{loadStatus === 'loading'}}" text="正在加载最近删除" />
  <error-state wx:elif="{{loadStatus === 'error'}}" title="最近删除加载失败" description="请检查网络后重新加载" bind:retry="onRetryLoad" />
  <empty-state wx:elif="{{loadStatus === 'empty'}}" symbol="录" title="最近没有删除记录" description="删除的饮食记录会出现在这里" />

  <view class="trash-list" wx:else>
    <view class="trash-card" wx:for="{{records}}" wx:key="recordId">
      <app-card>
        <view class="record-heading">
          <view class="record-main">
            <view class="record-title-row">
              <text class="record-title">{{item._titleText}}</text>
              <text class="meal-type">{{item._mealTypeText}}</text>
            </view>
            <text class="record-meta">记录于 {{item._recordedTime}}</text>
            <text class="record-meta record-meta--deleted">删除于 {{item._deletedTime}}</text>
          </view>
          <view
            class="restore-action {{restoringId ? 'restore-action--disabled' : ''}}"
            bindtap="onRestore"
            data-id="{{item.recordId}}"
            aria-role="button"
            aria-disabled="{{restoringId ? true : false}}"
          >{{restoringId === item.recordId ? '恢复中…' : '恢复'}}</view>
        </view>
        <text class="record-items" wx:if="{{item._itemsText}}">{{item._itemsText}}</text>
      </app-card>
    </view>
    <view class="load-more">{{loadingMore ? '正在加载更多…' : (hasMore ? '继续上滑加载更多' : '已加载全部记录')}}</view>
  </view>
</view>
