.candidate-page { min-height: 100vh; box-sizing: border-box; padding: var(--space-md) var(--space-page) calc(var(--space-xl) + env(safe-area-inset-bottom)); background: var(--color-background); }
.page-intro { padding: var(--space-sm) var(--space-xs) var(--space-md); }
.page-title { display: block; color: var(--color-text-primary); font-size: var(--font-page-title); font-weight: 800; }
.page-description { display: block; margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); line-height: 1.6; }
.source-tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-sm); margin-bottom: var(--space-md); }
.source-tab { display: flex; min-height: var(--tap-min-size); flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid transparent; border-radius: var(--radius-card); background: var(--color-surface); color: var(--color-text-secondary); }
.source-tab--active { border-color: var(--color-primary); background: var(--color-meal-soft); color: var(--color-primary); }
.source-name { font-size: var(--font-body); font-weight: 700; }
.source-count { margin-top: 4rpx; font-size: 21rpx; }
.sync-warning { margin-bottom: var(--space-sm); padding: var(--space-sm); border-radius: var(--radius-sm); background: #fff8e8; color: var(--color-warning); font-size: var(--font-caption); line-height: 1.5; }
.editor-card { margin-bottom: var(--space-lg); }
.editor-header, .list-header, .candidate-title-row, .candidate-row, .candidate-actions { display: flex; align-items: center; }
.editor-header, .list-header { justify-content: space-between; }
.editor-title, .list-title { color: var(--color-text-primary); font-size: var(--font-section-title); font-weight: 700; }
.cancel-edit, .restore-button { display: flex; min-height: var(--tap-min-size); align-items: center; color: var(--color-primary); font-size: var(--font-caption); }
.candidate-input { box-sizing: border-box; width: 100%; height: 82rpx; margin-top: var(--space-sm); padding: 0 var(--space-sm); border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); background: #fafbfc; color: var(--color-text-primary); font-size: var(--font-body); }
.note-input { margin-top: 12rpx; }
.save-button { display: flex; min-height: var(--tap-min-size); align-items: center; justify-content: center; margin-top: var(--space-md); border-radius: var(--radius-sm); background: var(--color-primary); color: #fff; font-size: var(--font-body); font-weight: 700; }
.save-button--disabled { opacity: 0.55; }
.list-header { min-height: var(--tap-min-size); padding: 0 var(--space-xs); }
.candidate-list { display: grid; gap: var(--space-sm); }
.candidate-row { min-height: var(--tap-min-size); }
.candidate-row--disabled { opacity: 0.58; }
.candidate-copy { min-width: 0; flex: 1; }
.candidate-title-row { min-width: 0; gap: var(--space-xs); }
.candidate-name { overflow: hidden; color: var(--color-text-primary); font-size: var(--font-body); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.candidate-status { flex-shrink: 0; padding: 4rpx 10rpx; border-radius: 999rpx; background: var(--color-meal-soft); color: var(--color-primary); font-size: 20rpx; }
.candidate-row--disabled .candidate-status { background: var(--color-background); color: var(--color-text-muted); }
.candidate-note { display: block; margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); line-height: 1.45; word-break: break-all; }
.candidate-switch { flex-shrink: 0; margin-left: var(--space-sm); transform: scale(0.88); }
.candidate-actions { justify-content: flex-end; gap: var(--space-sm); margin-top: var(--space-xs); border-top: 1rpx solid var(--color-border); }
.candidate-action { display: flex; min-width: var(--tap-min-size); min-height: var(--tap-min-size); align-items: center; justify-content: center; color: var(--color-text-secondary); font-size: var(--font-caption); }
.candidate-action--danger { color: var(--color-danger); }
