.shopping-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f5f6fa;
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff8a5c, #ff5b2d);
  color: #fff;
  margin-bottom: 20rpx;
}

.summary-num { font-size: 52rpx; font-weight: 800; margin-right: 12rpx; }
.summary-label { font-size: 28rpx; }
.summary-tip { width: 280rpx; font-size: 22rpx; line-height: 1.5; opacity: .86; text-align: right; }

.list-tip { padding: 8rpx 12rpx 20rpx; color: #999; font-size: 24rpx; }

.shopping-item {
  display: flex;
  align-items: center;
  min-height: 110rpx;
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #fff;
}

.check-box {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  flex-shrink: 0;
  text-align: center;
  border: 2rpx solid #d6dbe1;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
}

.check-box.checked { background: #26de81; border-color: #26de81; }
.item-info { min-width: 0; flex: 1; margin-left: 20rpx; }
.item-main { display: flex; align-items: baseline; gap: 14rpx; }
.item-name { font-size: 30rpx; font-weight: 600; color: #333; }
.item-amount { font-size: 24rpx; color: #ff6b35; }
.item-source { display: block; margin-top: 8rpx; font-size: 22rpx; color: #999; }
.item-status { margin-left: 16rpx; flex-shrink: 0; font-size: 23rpx; color: #ff6b35; }
.shopping-item.in-stock { opacity: .62; }
.shopping-item.in-stock .item-name { text-decoration: line-through; }
.shopping-item.in-stock .item-status { color: #26a96c; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 230rpx; }
.empty-icon { font-size: 112rpx; }
.empty-title { margin-top: 24rpx; font-size: 30rpx; font-weight: 600; color: #444; }
.empty-tip { margin-top: 10rpx; font-size: 25rpx; color: #999; }
.menu-btn { margin-top: 42rpx; padding: 18rpx 52rpx; border-radius: 40rpx; color: #fff; font-size: 28rpx; background: linear-gradient(135deg, #ff6b35, #ff4500); }
