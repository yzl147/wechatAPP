.shopping-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-lg) var(--space-page) calc(var(--space-xl) + env(safe-area-inset-bottom));
  background: var(--color-background);
}
.page-intro, .inventory-entry, .warning-card, .summary-card, .shopping-section { margin-bottom: var(--space-md); }
.page-title, .page-description, .entry-title, .entry-description, .warning-text, .summary-value, .summary-label,
.section-title, .section-description, .source-text, .stock-text { display: block; }
.page-title { color: var(--color-text-primary); font-size: var(--font-page-title); font-weight: 700; }
.page-description { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-body); line-height: 1.5; }
.inventory-entry__content, .summary-content, .item-content, .item-title-row { display: flex; align-items: center; }
.inventory-entry__content { min-height: var(--tap-min-size); }
.entry-symbol {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  border-radius: var(--radius-sm);
  background: var(--color-life);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.entry-copy { min-width: 0; flex: 1; }
.entry-title { color: var(--color-text-primary); font-size: var(--font-section-title); font-weight: 700; }
.entry-description { margin-top: 4rpx; color: var(--color-text-secondary); font-size: var(--font-caption); }
.entry-action { margin-left: var(--space-sm); color: var(--color-life); font-size: var(--font-body); font-weight: 700; }
.warning-text { color: var(--color-warning); font-size: var(--font-caption); line-height: 1.5; }

.summary-content { display: grid; grid-template-columns: 1fr 1rpx 1fr; position: relative; padding-bottom: 64rpx; text-align: center; }
.summary-value { color: var(--color-warning); font-size: 42rpx; font-weight: 800; }
.summary-label { margin-top: 3rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.summary-divider { width: 1rpx; height: 58rpx; background: var(--color-border); }
.summary-copy { position: absolute; right: 0; bottom: 0; left: 0; color: var(--color-text-muted); font-size: 20rpx; line-height: 1.4; }
.section-heading { display: flex; min-height: var(--tap-min-size); align-items: center; justify-content: space-between; }
.section-title { color: var(--color-text-primary); font-size: var(--font-section-title); font-weight: 700; }
.section-description { margin-top: 5rpx; color: var(--color-text-muted); font-size: var(--font-caption); }
.shopping-item { margin-bottom: var(--space-sm); }
.item-content { min-height: var(--tap-min-size); }
.check-box {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  border: 2rpx solid var(--color-text-disabled);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.check-box--checked { border-color: var(--color-life); background: var(--color-life); }
.item-copy { min-width: 0; flex: 1; }
.item-title-row { gap: var(--space-xs); }
.item-name { min-width: 0; overflow: hidden; color: var(--color-text-primary); font-size: var(--font-body); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.amount-tag { flex-shrink: 0; padding: 3rpx 9rpx; border-radius: 8rpx; background: var(--color-meal-soft); color: var(--color-meal); font-size: 20rpx; }
.source-text, .stock-text { margin-top: 5rpx; overflow: hidden; color: var(--color-text-muted); font-size: 21rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.stock-text--enough { color: var(--color-success); }
.stock-text--partial { color: var(--color-warning); }
.stock-text--none, .stock-text--manual { color: var(--color-text-secondary); }
.status-action { width: 126rpx; flex: 0 0 126rpx; margin-left: var(--space-sm); color: var(--color-text-secondary); font-size: 20rpx; font-weight: 700; text-align: right; }
