.completion-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; background: #f5f6fa; }.hero-card { display: flex; flex-direction: column; align-items: center; padding: 36rpx; border-radius: 22rpx; color: #fff; background: linear-gradient(135deg, #5b8ec9, #4776a9); }.hero-symbol { display: flex; width: 80rpx; height: 80rpx; align-items: center; justify-content: center; border-radius: 50%; color: #fff; font-size: 28rpx; font-weight: 800; background: rgba(255, 255, 255, 0.2); }.hero-title { margin-top: 10rpx; font-size: 34rpx; font-weight: 700; }.hero-time { margin-top: 10rpx; font-size: 23rpx; opacity: .85; }.section { margin-top: 20rpx; padding: 26rpx; border-radius: 18rpx; background: #fff; }.section-title { display: block; font-size: 31rpx; font-weight: 700; color: #333; }.section-sub { display: block; margin: 8rpx 0 14rpx; font-size: 23rpx; color: #999; }.item-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f2f2f2; color: #666; font-size: 27rpx; }.check { display: flex; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; margin-right: 14rpx; border-radius: 50%; color: #fff; font-size: 20rpx; background: #26a96c; }.empty-items { padding: 24rpx 0; text-align: center; color: #aaa; font-size: 25rpx; }.open-list { margin-top: 26rpx; padding: 22rpx; border-radius: 42rpx; text-align: center; color: #4e7dae; font-size: 27rpx; background: #eef5ff; }
