<view class="detail-page">
  <!-- 详情加载状态、空状态和内容 -->
  <view class="detail-state" wx:if="{{loadStatus === 'loading'}}">正在加载饮食记录...</view>
  <view class="detail-state" wx:elif="{{loadStatus === 'error'}}"><text>饮食记录加载失败</text><button class="retry-btn" bindtap="onRetryLoad">重新加载</button></view>
  <view class="empty-record" wx:elif="{{loadStatus === 'empty'}}">
    <text class="empty-symbol" aria-hidden="true">录</text>
    <text class="empty-text">记录不存在</text>
    <view class="btn-back" bindtap="goToIndex">返回首页</view>
  </view>
  <block wx:else>
    <view class="status-section" style="background: linear-gradient(135deg, #26de81, #20bf6b);">
      <text class="status-symbol" aria-hidden="true">饮</text>
      <text class="status-text">{{record.mealTypeText}}记录</text>
      <text class="record-id" wx:if="{{record.venue}}">{{record.venue}}</text>
      <text class="record-id">记录编号: {{record.recordId}}</text>
      <text class="record-time">{{record._timeText}}</text>
    </view>

    <!-- 菜品明细 -->
    <view class="section">
      <view class="section-header">
        <view class="section-title-bar"></view>
        <text class="section-title">{{record.isCook ? '今天做了什么' : '吃了什么'}}</text>
      </view>

      <view class="item-list">
        <view class="record-item" wx:for="{{record.items}}" wx:key="id">
          <view class="oi-img-wrap">
            <image class="oi-img" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load />
            <text class="oi-img oi-placeholder" wx:else aria-hidden="true">餐</text>
          </view>
          <view class="oi-info">
            <text class="oi-name">{{item.name}}</text>
          <text class="oi-spec">{{record.isCook ? '准备' : '记录' }} {{item.quantity}} 份</text>
          </view>
        </view>
      </view>

      <view class="count-summary">
        <view class="ps-row">
          <text class="ps-label">菜品数量</text>
          <text class="ps-value">共 {{record.totalCount}} 份</text>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="section" wx:if="{{record.remark}}">
      <view class="section-header">
        <view class="section-title-bar remark-bar"></view>
        <text class="section-title">备注</text>
      </view>
      <text class="remark-text">{{record.remark}}</text>
    </view>

    <!-- 删除后保留当前详情，允许用户在离开前撤销 -->
    <view class="deletion-recovery" wx:if="{{isDeleted}}">
      <text class="deletion-recovery__title">这条记录已删除</text>
      <text class="deletion-recovery__description">离开当前页面前仍可撤销，恢复后会重新出现在记录和月历中。</text>
      <view class="deletion-recovery__actions">
        <view class="btn-undo {{restorePending ? 'action-disabled' : ''}}" bindtap="onUndoDelete" aria-role="button" aria-disabled="{{restorePending}}">{{restorePending ? '正在恢复…' : '撤销删除'}}</view>
        <view class="btn-secondary" bindtap="onViewMealRecords" aria-role="button">返回记录</view>
      </view>
    </view>

    <view class="action-area" wx:else>
      <view class="btn-reuse" wx:if="{{record.isCook}}" bindtap="onReuseMeal">复用这一餐</view>
      <view class="btn-delete {{deletePending ? 'action-disabled' : ''}}" bindtap="onDeleteRecord" aria-role="button" aria-disabled="{{deletePending}}">{{deletePending ? '正在删除…' : '删除记录'}}</view>
      <view class="btn-primary" bindtap="onViewMealRecords">
        查看饮食记录
      </view>
      <view class="btn-secondary" bindtap="goToIndex" wx:if="{{!fromHistory}}">
        继续选菜
      </view>
    </view>
  </block>

  <view class="bottom-space"></view>
</view>
