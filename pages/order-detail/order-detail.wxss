.detail-page {
  min-height: 100vh;
  background-color: #f5f6fa;
}

/* 空状态 */
.empty-record {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-symbol {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: #fff0e8;
  color: #d95f25;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-back {
  background: linear-gradient(135deg, #ff6b35, #ff4500);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 60rpx;
  border-radius: 44rpx;
}

/* 状态区域 */
.status-section {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-symbol {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.status-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 12rpx;
}

.record-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

/* 通用区域 */
.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-bar {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #ff6b35, #ff4500);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.remark-bar {
  background: linear-gradient(180deg, #74b9ff, #0984e3);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* 饮食记录菜品列表 */
.item-list {
  margin-bottom: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.oi-img-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #f0f0f0;
}

.oi-img {
  width: 100%;
  height: 100%;
}

.oi-placeholder { display: flex; align-items: center; justify-content: center; background: #fff3ea; color: #d95f25; font-size: 25rpx; font-weight: 800; }

.oi-info {
  flex: 1;
  margin-left: 16rpx;
}

.oi-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.oi-spec {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 份数汇总 */
.count-summary {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.ps-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.ps-label {
  font-size: 26rpx;
  color: #666;
}

.ps-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 备注 */
.remark-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

/* 操作按钮区 */
.action-area {
  padding: 40rpx 32rpx;
  display: flex;
  gap: 20rpx;
}

.btn-primary {
  flex: 1;
  text-align: center;
  background: linear-gradient(135deg, #ff6b35, #ff4500);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 44rpx;
}

.btn-delete {
  flex: 1;
  text-align: center;
  background: linear-gradient(135deg, #ff6b6b, #e74c3c);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 44rpx;
}

.action-disabled { opacity: 0.5; pointer-events: none; }

.deletion-recovery { margin: 20rpx; padding: 28rpx 32rpx; border: 1rpx solid #f1d59a; border-radius: 20rpx; background: #fff8e8; }
.deletion-recovery__title { display: block; color: #8a5600; font-size: 30rpx; font-weight: 700; }
.deletion-recovery__description { display: block; margin-top: 10rpx; color: #78684e; font-size: 24rpx; line-height: 1.6; }
.deletion-recovery__actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-undo { flex: 1; padding: 20rpx 0; border-radius: 40rpx; background: #ff6b35; color: #fff; font-size: 28rpx; font-weight: 600; text-align: center; }

.btn-reuse {
  flex: 1;
  text-align: center;
  background: linear-gradient(135deg, #26de81, #20bf6b);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 44rpx;
}

.btn-secondary {
  flex: 1;
  text-align: center;
  background: #f5f6fa;
  color: #666;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 44rpx;
}

.bottom-space {
  height: 60rpx;
}

.detail-state { display: flex; flex-direction: column; align-items: center; padding: 180rpx 32rpx; color: #999; font-size: 28rpx; }
.retry-btn { margin-top: 28rpx; padding: 0 36rpx; color: #ff6b35; border: 1rpx solid #ff6b35; border-radius: 32rpx; background: #fff; font-size: 26rpx; line-height: 60rpx; }
.retry-btn::after { border: 0; }
