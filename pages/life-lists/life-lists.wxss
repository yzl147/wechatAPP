.lists-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; background: #f5f6fa; }
.create-card, .list-card { border-radius: 20rpx; background: #fff; box-shadow: 0 3rpx 14rpx rgba(0,0,0,.04); }.create-card { padding: 28rpx; }.create-title, .section-title { display: block; font-size: 30rpx; font-weight: 700; color: #333; }.title-input, .items-input { box-sizing: border-box; width: 100%; margin-top: 18rpx; padding: 16rpx 20rpx; border: 1rpx solid #eceef2; border-radius: 12rpx; background: #fafbfc; font-size: 26rpx; }.items-input { min-height: 120rpx; }.repeat-picker { display: flex; justify-content: space-between; margin-top: 14rpx; padding: 17rpx 20rpx; border-radius: 12rpx; background: #fafbfc; color: #666; font-size: 25rpx; }.repeat-picker text { color: #aaa; font-size: 32rpx; }.create-btn { margin-top: 20rpx; padding: 18rpx 0; border-radius: 40rpx; text-align: center; color: #fff; font-size: 28rpx; background: linear-gradient(135deg, #ff6b35, #ff4500); }.section-title { margin: 30rpx 8rpx 16rpx; }.template-row { display: flex; gap: 16rpx; }.template-card { flex: 1; display: flex; flex-direction: column; gap: 8rpx; align-items: center; padding: 24rpx; border-radius: 18rpx; background: #fff4ee; color: #754330; font-size: 26rpx; }.template-card text:first-child { font-size: 42rpx; }.list-card { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; padding: 26rpx; }.list-name { display: block; font-size: 29rpx; font-weight: 600; color: #333; }.list-progress { display: block; margin-top: 8rpx; font-size: 23rpx; color: #999; }.arrow { font-size: 42rpx; color: #ff6b35; }.empty-state { padding: 58rpx 0; text-align: center; color: #aaa; font-size: 26rpx; }
