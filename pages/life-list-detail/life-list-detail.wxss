.detail-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; background: #f5f6fa; }.progress-card { display: flex; flex-direction: column; align-items: center; padding: 28rpx; border-radius: 20rpx; color: #fff; background: linear-gradient(135deg, #ff8a5c, #ff5b2d); font-size: 24rpx; }.progress-num { margin-bottom: 8rpx; font-size: 46rpx; font-weight: 800; }.add-row { display: flex; align-items: center; margin: 22rpx 0; padding: 8rpx 12rpx 8rpx 20rpx; border-radius: 16rpx; background: #fff; }.add-row input { flex: 1; height: 62rpx; font-size: 26rpx; }.add-row text { padding: 12rpx 18rpx; color: #ff6b35; font-size: 26rpx; }.item-card { display: flex; align-items: center; margin-bottom: 14rpx; padding: 22rpx; border-radius: 16rpx; background: #fff; }.item-check { width: 38rpx; height: 38rpx; line-height: 36rpx; flex-shrink: 0; text-align: center; border: 2rpx solid #d6dbe1; border-radius: 50%; color: #fff; }.item-text { flex: 1; margin-left: 18rpx; font-size: 28rpx; color: #444; }.item-card.done .item-check { border-color: #26a96c; background: #26a96c; }.item-card.done .item-text { color: #aaa; text-decoration: line-through; }.remove { padding: 0 8rpx; color: #bbb; font-size: 38rpx; line-height: 1; }.delete-list { margin: 42rpx auto; padding: 18rpx; text-align: center; color: #e74c3c; font-size: 26rpx; }
