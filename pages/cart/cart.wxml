<view class="meal-list-page">
  <view class="page-intro">
    <text class="page-title">今日饮食清单</text>
    <text class="page-description">整理今天准备做的菜、食材缺口和饮食记录。</text>
  </view>

  <loading-state wx:if="{{loadStatus === 'loading'}}" text="正在加载今日饮食清单..." />
  <error-state wx:elif="{{loadStatus === 'error'}}" title="今日饮食清单加载失败" description="请检查网络后重新加载" bind:retry="onRetryLoad" />
  <empty-state wx:elif="{{mealList.length === 0}}" symbol="饮" title="今天还没有选菜" description="从菜谱中挑几道想做的菜，再回来准备食材。" actionText="去选菜" bind:action="goToIndex" />

  <block wx:else>
    <view class="section-header">
      <view>
        <text class="section-title">今天准备做什么？</text>
        <text class="section-caption">共 {{mealList.length}} 道菜，{{totalCount}} 份</text>
      </view>
      <text class="clear-action {{clearPending || mutationPendingId || savePending ? 'action-disabled' : ''}}" bindtap="onClearMealList" aria-role="button" aria-disabled="{{clearPending || mutationPendingId || savePending}}">
        {{clearPending ? '正在清空...' : '清空清单'}}
      </text>
    </view>

    <view class="dish-list">
      <app-card wx:for="{{mealList}}" wx:key="_id">
        <view class="dish-main">
          <view class="dish-image-wrap" catchtap="onPreviewImage" data-url="{{item.image}}">
            <image class="dish-image" src="{{item.image}}" mode="aspectFill" lazy-load />
          </view>
          <view class="dish-copy">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-brief">{{item.brief || '查看采购清单，准备这道菜需要的食材'}}</text>
          </view>
        </view>
        <view class="dish-actions">
          <quantity-stepper
            itemId="{{item.itemId}}"
            value="{{item.quantity}}"
            disabled="{{mutationPendingId > 0 || clearPending || savePending}}"
            decreaseLabel="减少 {{item.name}} 一份"
            increaseLabel="增加 {{item.name}} 一份"
            bind:decrease="onDecrease"
            bind:increase="onIncrease"
          />
          <view class="delete-action {{mutationPendingId || clearPending || savePending ? 'action-disabled' : ''}}" data-id="{{item.itemId}}" catchtap="onDeleteItem" aria-role="button" aria-disabled="{{mutationPendingId || clearPending || savePending}}">删除</view>
        </view>
      </app-card>
    </view>

    <view class="section-header ingredient-heading">
      <view>
        <text class="section-title">还缺什么食材？</text>
        <text class="section-caption">库存和采购状态会自动合并计算</text>
      </view>
    </view>

    <app-card variant="warning" interactive bind:tap="goToShoppingList">
      <view class="shopping-summary" aria-role="button" aria-label="进入食材采购清单">
        <view class="shopping-symbol">备</view>
        <view class="shopping-copy">
          <text class="shopping-title" wx:if="{{shoppingLoadStatus === 'loading'}}">正在计算食材缺口...</text>
          <text class="shopping-title" wx:elif="{{shoppingLoadStatus === 'error'}}">食材缺口暂时无法计算</text>
          <text class="shopping-title" wx:else>{{shoppingSummaryText}}</text>
          <text class="shopping-description">{{shoppingWarning || '查看每种食材的库存、缺口和采购状态'}}</text>
        </view>
        <view class="shopping-arrow" aria-hidden="true">›</view>
      </view>
    </app-card>

    <view class="save-card-wrap">
      <app-card variant="meal">
        <view class="save-explanation">
          <text class="save-title">保存今天的饮食记录</text>
          <text class="save-description">确认后会清空今日清单，并在记录页保留今天准备的菜。</text>
        </view>
      </app-card>
    </view>

    <bottom-action-bar summary="已选 {{totalCount}} 份" primaryText="保存今日记录" pendingText="正在保存..." pending="{{savePending}}" bind:primary="onSaveRecord" />
  </block>
</view>
