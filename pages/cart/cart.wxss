.meal-list-page { min-height: 100vh; box-sizing: border-box; padding: var(--space-md) var(--space-page) calc(176rpx + env(safe-area-inset-bottom)); background: var(--color-background); }
.page-intro { padding: var(--space-sm) var(--space-xs) var(--space-lg); }
.page-title { display: block; color: var(--color-text-primary); font-size: var(--font-page-title); font-weight: 800; }
.page-description { display: block; margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); line-height: 1.6; }
.section-header { display: flex; min-height: var(--tap-min-size); align-items: center; justify-content: space-between; padding: 0 var(--space-xs); }
.section-title { display: block; color: var(--color-text-primary); font-size: var(--font-section-title); font-weight: 700; }
.section-caption { display: block; margin-top: 4rpx; color: var(--color-text-muted); font-size: var(--font-caption); line-height: 1.45; }
.clear-action { display: flex; min-height: var(--tap-min-size); align-items: center; color: var(--color-danger); font-size: var(--font-caption); }
.action-disabled { opacity: 0.5; }
.dish-list { display: grid; gap: var(--space-sm); }
.dish-main { display: flex; min-width: 0; align-items: center; }
.dish-image-wrap { width: 116rpx; height: 116rpx; flex-shrink: 0; overflow: hidden; border-radius: var(--radius-sm); background: var(--color-background); }
.dish-image { width: 100%; height: 100%; }
.dish-copy { min-width: 0; flex: 1; margin-left: var(--space-md); }
.dish-name { display: block; overflow: hidden; color: var(--color-text-primary); font-size: var(--font-card-title); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.dish-brief { display: -webkit-box; overflow: hidden; margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.dish-actions { display: flex; min-height: var(--tap-min-size); align-items: center; justify-content: space-between; gap: var(--space-sm); margin-top: var(--space-sm); padding-top: var(--space-xs); border-top: 1rpx solid var(--color-border); }
.delete-action { display: flex; min-width: var(--tap-min-size); min-height: var(--tap-min-size); align-items: center; justify-content: flex-end; color: var(--color-danger); font-size: var(--font-caption); }
.ingredient-heading { margin-top: var(--space-lg); }
.shopping-summary { display: flex; min-height: 104rpx; align-items: center; }
.shopping-symbol { display: flex; width: 72rpx; height: 72rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: var(--radius-sm); background: #fff1d6; color: var(--color-warning); font-size: var(--font-caption); font-weight: 800; }
.shopping-copy { min-width: 0; flex: 1; margin-left: var(--space-md); }
.shopping-title { display: block; color: var(--color-text-primary); font-size: var(--font-body); font-weight: 700; }
.shopping-description { display: block; margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); line-height: 1.45; }
.shopping-arrow { display: flex; min-width: var(--tap-min-size); min-height: var(--tap-min-size); align-items: center; justify-content: flex-end; color: var(--color-warning); font-size: 48rpx; }
.save-card-wrap { margin-top: var(--space-lg); }
.save-title { display: block; color: var(--color-text-primary); font-size: var(--font-body); font-weight: 700; }
.save-description { display: block; margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); line-height: 1.55; }
@media (max-width: 340px) { .dish-actions { align-items: flex-end; flex-direction: column; } .delete-action { justify-content: center; } }
