<view class="meal-record-page">
  <view class="intro"><text class="intro-title">这顿怎么吃？</text><text class="intro-tip">自己做的菜请从饮食清单保存，这里用于记录外出和外卖。</text></view>
  <view class="type-row"><view class="type-card {{mealType === 'dine_out' ? 'active' : ''}}" bindtap="chooseType" data-type="dine_out" aria-role="button" aria-label="选择外出吃" aria-checked="{{mealType === 'dine_out'}}"><text class="type-symbol">堂</text><text>外出吃</text><text class="type-tip">餐馆、食堂</text></view><view class="type-card {{mealType === 'takeout' ? 'active' : ''}}" bindtap="chooseType" data-type="takeout" aria-role="button" aria-label="选择点外卖" aria-checked="{{mealType === 'takeout'}}"><text class="type-symbol">外</text><text>点外卖</text><text class="type-tip">外卖店铺</text></view></view>
  <view class="form-card"><view class="field"><text class="label">{{mealType === 'dine_out' ? '餐馆或地点' : '外卖店铺'}}</text><input placeholder="例如：公司楼下兰州拉面" value="{{venue}}" bindinput="onVenueInput" maxlength="40" /></view><view class="field"><text class="label">吃了什么</text><input placeholder="例如：牛肉面、小菜" value="{{dishes}}" bindinput="onDishesInput" maxlength="80" /></view><view class="field no-border"><text class="label">备注（可选）</text><textarea placeholder="例如：和同事一起吃" value="{{remark}}" bindinput="onRemarkInput" maxlength="120" auto-height /></view></view>
  <view class="save-btn" bindtap="saveMeal">保存饮食记录</view>
</view>
