.meal-record-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 24rpx; background: #f5f6fa; }.intro { margin: 6rpx 8rpx 24rpx; }.intro-title, .intro-tip { display: block; }.intro-title { color: #333; font-size: 38rpx; font-weight: 800; }.intro-tip { margin-top: 10rpx; color: #999; font-size: 23rpx; line-height: 1.6; }.type-row { display: flex; gap: 16rpx; }.type-card { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 26rpx 12rpx; border: 2rpx solid transparent; border-radius: 20rpx; color: #666; font-size: 28rpx; background: #fff; }.type-card.active { border-color: #ff8a5c; color: #d95f25; background: #fff7f2; }.type-symbol { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; margin-bottom: 10rpx; border-radius: 18rpx; color: #d95f25; font-size: 25rpx; font-weight: 800; background: #fff0e8; }.type-card.active .type-symbol { color: #fff; background: #f45b2a; }.type-tip { margin-top: 6rpx; color: #aaa; font-size: 21rpx; }.form-card { margin-top: 22rpx; padding: 0 24rpx; border-radius: 20rpx; background: #fff; }.field { padding: 24rpx 0; border-bottom: 1rpx solid #f2f2f2; }.field.no-border { border-bottom: none; }.label { display: block; margin-bottom: 14rpx; color: #444; font-size: 27rpx; font-weight: 600; }.field input, .field textarea { width: 100%; color: #333; font-size: 27rpx; }.save-btn { margin-top: 34rpx; padding: 24rpx 0; border-radius: 48rpx; text-align: center; color: #fff; font-size: 30rpx; font-weight: 700; background: linear-gradient(135deg, #ff8a5c, #ff5b2d); }
