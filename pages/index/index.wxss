.container {
  display: block;
  height: auto;
  padding: 20rpx;
  background-color: #f5f6fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  height: 72rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.category-item.active {
  background: linear-gradient(135deg, #ff6b35, #ff4500);
  color: #fff;
  font-weight: 500;
}

/* 美食卡片 */
.food-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.food-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.food-card:active {
  transform: scale(0.98);
  transition: transform 0.1s;
}

.food-image-wrap {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #f0f0f0;
}

.food-image {
  width: 100%;
  height: 100%;
}

.food-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 180rpx;
}

.food-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.food-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.food-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.food-tag.tag-meat { background: #ffebee; color: #d32f2f; }
.food-tag.tag-vege { background: #e8f5e9; color: #388e3c; }
.food-tag.tag-seafood { background: #e3f2fd; color: #1976d2; }
.food-tag.tag-staple { background: #fff3e0; color: #f57c00; }

.favorite-mark {
  color: #ff6b35;
  font-size: 28rpx;
  line-height: 1;
}

.food-brief {
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.food-meta {
  display: flex;
  gap: 24rpx;
  margin-top: auto;
}

.meta-item {
  font-size: 22rpx;
  color: #999;
}

/* 价格区域 */
.price-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.price {
  font-size: 30rpx;
  font-weight: 800;
  color: #ff6b35;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 46rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff6b35, #ff4500);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}

/* 空状态 */
.empty {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #bbb;
}

.page-state { display: flex; flex-direction: column; align-items: center; padding: 140rpx 32rpx; color: #999; font-size: 28rpx; }
.retry-btn { margin-top: 28rpx; padding: 0 36rpx; color: #ff6b35; border: 1rpx solid #ff6b35; border-radius: 32rpx; background: #fff; font-size: 26rpx; line-height: 60rpx; }
.retry-btn::after { border: 0; }
