.catalog-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-lg) var(--space-page) calc(var(--space-xl) + env(safe-area-inset-bottom));
  background: var(--color-background);
}

.page-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}
.page-intro__copy { min-width: 0; flex: 1; }
.page-title, .page-description, .dish-name, .dish-brief { display: block; }
.page-title { color: var(--color-text-primary); font-size: var(--font-page-title); font-weight: 700; }
.page-description { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-body); line-height: 1.5; }
.today-list {
  display: flex;
  min-width: 118rpx;
  min-height: var(--tap-min-size);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-sm);
  border: 1rpx solid rgba(244, 91, 42, 0.14);
  border-radius: var(--radius-sm);
  background: var(--color-meal-soft);
}
.today-list__count { color: var(--color-meal); font-size: 32rpx; font-weight: 800; }
.today-list__label { margin-top: 2rpx; color: var(--color-text-secondary); font-size: 20rpx; }

.search-box {
  display: flex;
  height: var(--tap-min-size);
  align-items: center;
  margin-bottom: var(--space-sm);
  padding-left: var(--space-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.search-input { height: 100%; min-width: 0; flex: 1; color: var(--color-text-primary); font-size: var(--font-body); }
.search-placeholder { color: var(--color-text-disabled); }
.search-clear {
  display: flex;
  width: var(--tap-min-size);
  height: var(--tap-min-size);
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  font-size: var(--font-caption);
}

.category-scroll { margin-bottom: var(--space-sm); white-space: nowrap; }
.category-list { display: inline-flex; gap: var(--space-sm); padding: 2rpx 0; }
.category-item {
  display: flex;
  min-width: 92rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-md);
  border: 1rpx solid var(--color-border);
  border-radius: 40rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}
.category-item--active { border-color: var(--color-primary); background: var(--color-primary); color: #fff; font-weight: 700; }

.result-bar {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: space-between;
  color: var(--color-text-muted);
  font-size: var(--font-caption);
}
.result-bar text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-bar text:last-child { flex-shrink: 0; margin-left: var(--space-sm); }
.dish-list { display: flex; flex-direction: column; gap: var(--space-md); }
.dish-main { display: flex; min-height: 176rpx; }
.dish-image-wrap {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  flex: 0 0 176rpx;
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--color-border);
}
.dish-image { width: 100%; height: 100%; }
.image-hint {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 7rpx 0;
  background: rgba(20, 22, 26, 0.56);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
}
.dish-copy { min-width: 0; flex: 1; margin-left: var(--space-md); }
.dish-title-row { display: flex; align-items: center; gap: var(--space-xs); }
.dish-name { min-width: 0; flex: 1; overflow: hidden; color: var(--color-text-primary); font-size: var(--font-card-title); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.favorite-tag, .category-tag {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  border-radius: 8rpx;
  font-size: 19rpx;
  line-height: 32rpx;
}
.favorite-tag { padding: 0 8rpx; background: var(--color-meal-soft); color: var(--color-meal); }
.category-tag { margin-top: 7rpx; padding: 0 10rpx; background: #eef0f3; color: var(--color-text-secondary); }
.dish-brief {
  display: -webkit-box;
  margin-top: var(--space-xs);
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.dish-meta { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-xs); color: var(--color-text-muted); font-size: 21rpx; }

.dish-actions {
  display: flex;
  min-height: var(--tap-min-size);
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-md);
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--color-border);
}
.detail-action, .add-action { display: flex; min-height: var(--tap-min-size); align-items: center; font-size: var(--font-body); }
.detail-action { flex: 1; color: var(--color-text-secondary); }
.add-action {
  min-width: 140rpx;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--color-primary);
  color: #fff;
  font-weight: 700;
}
.add-action--disabled { background: var(--color-text-disabled); }
