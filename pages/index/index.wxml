<view class="catalog-page">
  <view class="page-intro">
    <view class="page-intro__copy">
      <text class="page-title">挑一道想做的菜</text>
      <text class="page-description">查看食材和步骤，再加入今天的饮食清单</text>
    </view>
    <view class="today-list" bindtap="goToCart" aria-role="button">
      <text class="today-list__count">{{cartCount}}</text>
      <text class="today-list__label">今日已选</text>
    </view>
  </view>

  <view class="search-box">
    <input
      class="search-input"
      placeholder="搜索菜名或特点"
      placeholder-class="search-placeholder"
      value="{{searchText}}"
      bindinput="onSearchInput"
      confirm-type="search"
    />
    <view class="search-clear" wx:if="{{searchText}}" bindtap="onClearSearch" aria-role="button">清除</view>
  </view>

  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-list">
      <view
        class="category-item {{currentCategory === item ? 'category-item--active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-category="{{item}}"
        bindtap="onCategoryTap"
      >{{item}}</view>
    </view>
  </scroll-view>

  <loading-state wx:if="{{loadStatus === 'loading'}}" text="正在加载菜谱" />
  <error-state wx:elif="{{loadStatus === 'error'}}" title="菜谱加载失败" description="请检查网络后重新加载" bind:retry="onRetryLoad" />

  <block wx:else>
    <view class="result-bar"><text>{{currentCategory}}{{searchText ? ' · “' + searchText + '”' : ''}}</text><text>{{resultText}}</text></view>

    <empty-state
      wx:if="{{filteredList.length === 0}}"
      symbol="菜"
      title="{{emptyTitle}}"
      description="{{emptyDescription}}"
      actionText="查看全部菜谱"
      bind:action="onResetFilters"
    />

    <view class="dish-list" wx:else>
      <view class="dish-card" wx:for="{{filteredList}}" wx:key="id">
        <app-card>
          <view class="dish-main" bindtap="onFoodTap" data-id="{{item.id}}">
            <view class="dish-image-wrap" catchtap="onPreviewImage" data-url="{{item.image}}">
              <image class="dish-image" src="{{item.image}}" mode="aspectFill" lazy-load />
              <text class="image-hint">查看大图</text>
            </view>
            <view class="dish-copy">
              <view class="dish-title-row">
                <text class="dish-name">{{item.name}}</text>
                <text class="favorite-tag" wx:if="{{item.isFavorite}}">已收藏</text>
              </view>
              <text class="category-tag">{{item.category}}</text>
              <text class="dish-brief">{{item.brief}}</text>
              <view class="dish-meta">
                <text>用时 {{item.time}}</text>
                <text>难度 {{item.difficulty}}</text>
              </view>
            </view>
          </view>
          <view class="dish-actions">
            <view class="detail-action" bindtap="onFoodTap" data-id="{{item.id}}">查看食材与步骤</view>
            <view
              class="add-action {{addingDishId !== null ? 'add-action--disabled' : ''}}"
              catchtap="onAddToCart"
              data-food="{{item}}"
              aria-role="button"
            >{{addingDishId === item.id ? '加入中…' : '+ 加入'}}</view>
          </view>
        </app-card>
      </view>
    </view>
  </block>
</view>
