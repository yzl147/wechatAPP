<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索菜谱..." value="{{searchText}}" bindinput="onSearchInput" confirm-type="search" />
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-list">
      <text 
        class="category-item {{currentCategory === item ? 'active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="*this"
        data-category="{{item}}"
        bindtap="onCategoryTap"
      >{{item}}</text>
    </view>
  </scroll-view>

  <!-- 菜谱加载状态和列表 -->
  <view class="page-state" wx:if="{{loadStatus === 'loading'}}">正在加载菜谱...</view>
  <view class="page-state" wx:elif="{{loadStatus === 'error'}}">
    <text>菜谱加载失败</text>
    <button class="retry-btn" bindtap="onRetryLoad">重新加载</button>
  </view>
  <view class="food-list" wx:else>
    <view class="food-card" wx:for="{{filteredList}}" wx:key="id" bindtap="onFoodTap" data-id="{{item.id}}">
      <view class="food-image-wrap" catchtap="onPreviewImage" data-url="{{item.image}}">
        <image class="food-image" src="{{item.image}}" mode="aspectFill" lazy-load />
      </view>
      <view class="food-info">
        <view class="food-header">
          <text class="food-name">{{item.name}}</text>
          <view class="food-tag tag-{{item.catClass}}">{{item.category}}</view>
          <text class="favorite-mark" wx:if="{{item.isFavorite}}">♥</text>
        </view>
        <text class="food-brief">{{item.brief}}</text>
        <view class="food-meta">
          <text class="meta-item">⏱ {{item.time}}</text>
          <text class="meta-item">📊 {{item.difficulty}}</text>
        </view>
      </view>
      <!-- 价格和加购 -->
      <view class="price-area" catchtap="onAddToCart" data-food="{{item}}">
        <view class="add-btn">+</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{loadStatus === 'success' && filteredList.length === 0}}">
    <text class="empty-text">没有找到相关美食</text>
  </view>
</view>
