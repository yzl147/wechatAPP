.detail-root { min-height: 100vh; background: var(--color-background); }
.hero-section { position: relative; width: 100%; height: 420rpx; overflow: hidden; background: var(--color-border); }
.hero-image { width: 100%; height: 100%; }
.image-overlay { position: absolute; right: 0; bottom: 0; left: 0; height: 120rpx; background: linear-gradient(to top, rgba(20, 22, 26, 0.58), transparent); }
.preview-hint { position: absolute; bottom: var(--space-md); left: var(--space-page); color: rgba(255, 255, 255, 0.9); font-size: var(--font-caption); }
.favorite-action {
  position: absolute;
  top: var(--space-md);
  right: var(--space-page);
  display: flex;
  min-width: 132rpx;
  min-height: var(--tap-min-size);
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-sm);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 44rpx;
  background: rgba(20, 22, 26, 0.56);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
}
.favorite-action--active { border-color: var(--color-primary); background: var(--color-primary); }
.favorite-action--pending { opacity: 0.72; }

.detail-content { padding: var(--space-page); }
.detail-card { margin-bottom: var(--space-md); }
.category-tag {
  display: inline-flex;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-meal-soft);
  color: var(--color-meal);
  font-size: 21rpx;
}
.dish-title, .dish-brief, .overview-label, .overview-value, .section-title, .section-description, .step-title, .step-description { display: block; }
.dish-title { margin-top: var(--space-sm); color: var(--color-text-primary); font-size: var(--font-display); font-weight: 800; line-height: 1.25; }
.dish-brief { margin-top: var(--space-sm); color: var(--color-text-secondary); font-size: var(--font-body); line-height: 1.65; }
.overview-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-sm); margin-top: var(--space-md); }
.overview-item { padding: var(--space-sm); border-radius: var(--radius-sm); background: #f7f8fa; }
.overview-label { color: var(--color-text-muted); font-size: 21rpx; }
.overview-value { margin-top: 4rpx; color: var(--color-text-primary); font-size: var(--font-body); font-weight: 700; }

.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-md); }
.section-title { color: var(--color-text-primary); font-size: var(--font-section-title); font-weight: 700; }
.section-description { margin-top: 4rpx; color: var(--color-text-muted); font-size: var(--font-caption); }
.section-count { color: var(--color-text-muted); font-size: var(--font-caption); }

.ingredient-list { border-top: 1rpx solid var(--color-border); }
.ingredient-item { display: flex; min-height: var(--tap-min-size); align-items: center; border-bottom: 1rpx solid var(--color-border); }
.ingredient-item:last-child { border-bottom: 0; }
.item-index {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  border-radius: var(--radius-sm);
  background: var(--color-meal-soft);
  color: var(--color-meal);
  font-size: 21rpx;
  font-weight: 700;
}
.ingredient-name { min-width: 0; flex: 1; color: var(--color-text-primary); font-size: var(--font-body); }
.ingredient-amount { margin-left: var(--space-sm); color: var(--color-text-secondary); font-size: var(--font-caption); text-align: right; }

.step-item { display: flex; }
.step-guide { display: flex; width: 54rpx; flex: 0 0 54rpx; flex-direction: column; align-items: center; margin-right: var(--space-sm); }
.step-number {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 50rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 800;
}
.step-line { width: 2rpx; min-height: 40rpx; flex: 1; margin: var(--space-xs) 0; background: var(--color-border); }
.step-copy { min-width: 0; flex: 1; padding: 5rpx 0 var(--space-lg); }
.step-title { color: var(--color-text-primary); font-size: var(--font-body); font-weight: 700; }
.step-description { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-body); line-height: 1.7; }
.bottom-space { height: calc(136rpx + env(safe-area-inset-bottom)); }
