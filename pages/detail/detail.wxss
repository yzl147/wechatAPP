.detail-page {
  height: 100vh;
  background-color: #f5f6fa;
}

/* 头部大图区 */
.hero-section {
  width: 100%;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.hero-icon {
  font-size: 140rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(0,0,0,0.15));
}

.hero-content {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  z-index: 1;
}

.hero-name {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 10rpx;
}

.hero-brief {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-bottom: 14rpx;
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(4px);
}

.tag-cat {
  background: rgba(255, 255, 255, 0.35);
}

/* 区域通用样式 */
.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-steps {
  margin-top: 0;
  margin-bottom: 0;
  border-radius: 24rpx 24rpx 0 0;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title-bar {
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #ff6b35, #ff4500);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.step-bar {
  background: linear-gradient(180deg, #4facfe, #00f2fe);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  flex: 1;
}

.section-count {
  font-size: 22rpx;
  color: #aaa;
}

/* 食材网格 */
.ingredient-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  background: #fafbfc;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #f0f0f0;
}

.ingredient-index {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff6b35, #ff4500);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.ingredient-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

.ingredient-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ingredient-amount {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 制作步骤 */
.steps-container {
  padding-left: 8rpx;
}

.step-item {
  display: flex;
  position: relative;
}

.step-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-number-wrapper {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.step-number {
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
}

.step-line {
  width: 3rpx;
  flex: 1;
  background: linear-gradient(to bottom, #4facfe, #e8ecf1);
  margin: 8rpx 0;
  min-height: 40rpx;
}

.step-right {
  flex: 1;
  padding-bottom: 28rpx;
}

.step-card {
  background: #f8f9fc;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #4facfe;
}

.step-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 10rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.bottom-space {
  height: 60rpx;
}
