<view class="records-page {{selectMode ? 'records-page--managing' : ''}}">
  <view class="page-intro">
    <text class="page-title">记录</text>
    <text class="page-description">回看每一天吃了什么、完成了哪些生活清单</text>
  </view>

  <view class="view-switch" wx:if="{{!selectMode}}">
    <view class="view-switch__item {{viewMode === 'calendar' ? 'view-switch__item--active' : ''}}" bindtap="onViewModeTap" data-mode="calendar">日历</view>
    <view class="view-switch__item {{viewMode === 'list' ? 'view-switch__item--active' : ''}}" bindtap="onViewModeTap" data-mode="list">列表</view>
  </view>

  <loading-state wx:if="{{loadStatus === 'loading'}}" text="正在加载记录" />
  <error-state wx:elif="{{loadStatus === 'error'}}" title="记录加载失败" description="请检查网络后重新加载" bind:retry="onRetryLoad" />

  <block wx:else>
    <view class="quick-entry" wx:if="{{!selectMode}}">
      <app-card variant="meal" interactive bind:tap="goToMealRecord">
        <view class="quick-entry__content">
          <view>
            <text class="quick-entry__title">快速记一餐</text>
            <text class="quick-entry__description">外出吃或点外卖，简单记下地点和餐食</text>
          </view>
          <text class="quick-entry__action">去记录</text>
        </view>
      </app-card>
    </view>

    <block wx:if="{{viewMode === 'calendar'}}">
      <view class="calendar-section">
        <app-card>
          <view class="calendar-header">
            <view class="month-action" bindtap="onPreviousMonth" aria-label="上个月">‹</view>
            <text class="month-title">{{monthTitle}}</text>
            <view class="month-action {{isCurrentMonth ? 'month-action--disabled' : ''}}" bindtap="onNextMonth" aria-label="下个月">›</view>
          </view>
          <view class="week-row"><text wx:for="{{weekDays}}" wx:key="*this">{{item}}</text></view>
          <view class="day-grid">
            <view
              class="day-cell {{item.isSelected ? 'day-cell--selected' : ''}} {{item.isToday ? 'day-cell--today' : ''}} {{!item.date ? 'day-cell--empty' : ''}}"
              wx:for="{{calendarDays}}"
              wx:key="key"
              bindtap="onCalendarDateTap"
              data-date="{{item.date}}"
            >
              <text class="day-number">{{item.day}}</text>
              <view class="day-markers">
                <text class="day-marker day-marker--meal" wx:if="{{item.hasRecord}}">饮</text>
                <text class="day-marker day-marker--life" wx:if="{{item.hasLifeRecord}}">事</text>
              </view>
            </view>
          </view>
          <view class="calendar-footer">
            <view class="calendar-legend">
              <text class="legend-item legend-item--meal">饮 饮食</text>
              <text class="legend-item legend-item--life">事 生活</text>
            </view>
            <text class="today-action" wx:if="{{!isCurrentMonth || selectedDate !== today}}" bindtap="onGoToday">回到今天</text>
          </view>
        </app-card>
      </view>

      <empty-state wx:if="{{!selectedDate}}" symbol="日" title="选择一个日期" description="有“饮”或“事”标记的日期保存了记录" />

      <block wx:else>
        <view class="day-heading">
          <view><text class="section-title">{{selectedDateTitle}}</text><text class="section-description">当天记录</text></view>
        </view>

        <empty-state
          wx:if="{{displayRecords.length === 0 && selectedLifeRecords.length === 0}}"
          symbol="○"
          title="当天还没有记录"
          description="可以快速记一餐，或完成一份生活清单"
          action-text="快速记一餐"
          bind:action="goToMealRecord"
        />

        <view class="record-section" wx:if="{{selectedLifeRecords.length > 0}}">
          <text class="subsection-title">生活记录</text>
          <view class="record-card" wx:for="{{selectedLifeRecords}}" wx:key="id">
            <app-card variant="life" interactive>
              <view class="life-record" bindtap="onLifeRecordTap" data-id="{{item.id}}">
                <text class="record-mark record-mark--life">事</text>
                <view class="record-main"><text class="record-title">{{item.title}}</text><text class="record-meta">完成 {{item._itemCount}} 项 · 点击查看详情</text></view>
                <text class="record-arrow">›</text>
              </view>
            </app-card>
          </view>
        </view>

        <view class="record-section" wx:if="{{displayRecords.length > 0}}">
          <text class="subsection-title">饮食记录</text>
          <view class="record-card" wx:for="{{displayRecords}}" wx:key="recordId">
            <app-card interactive>
              <view class="meal-record" bindtap="onMealRecordTap" data-id="{{item.recordId}}">
                <text class="record-mark record-mark--meal">{{item.mealTypeMark}}</text>
                <view class="record-main">
                  <view class="record-title-row"><text class="record-title">{{item._titleText}}</text><text class="meal-type">{{item.mealTypeText}}</text></view>
                  <text class="record-meta">{{item._timeText}} · 共 {{item._totalCount}} 份</text>
                  <text class="record-items" wx:if="{{item._itemsText}}">{{item._itemsText}}</text>
                </view>
                <text class="record-arrow">›</text>
              </view>
            </app-card>
          </view>
        </view>
      </block>
    </block>

    <block wx:else>
      <view class="list-toolbar">
        <view><text class="section-title">全部饮食记录</text><text class="section-description">按时间从近到远排列</text></view>
        <view class="list-toolbar__actions" wx:if="{{!selectMode}}">
          <text class="trash-action" bindtap="goToDeletedRecords">最近删除</text>
          <text class="manage-action" wx:if="{{displayRecords.length > 0}}" bindtap="onEnterManage">管理</text>
        </view>
      </view>

      <view class="select-bar" wx:if="{{selectMode}}">
        <view class="select-action" bindtap="onToggleSelectAll"><text class="select-box {{isAllSelected ? 'select-box--checked' : ''}}">{{isAllSelected ? '✓' : ''}}</text><text>{{isAllSelected ? '取消全选' : '全选'}}</text></view>
        <text class="selected-count">已选 {{selectedRecordIds.length}} 条</text>
        <text class="cancel-action" bindtap="onCancelSelect">完成</text>
      </view>

      <empty-state wx:if="{{displayRecords.length === 0}}" symbol="录" title="还没有饮食记录" description="做饭、外出吃和外卖都可以保存在这里" action-text="快速记一餐" bind:action="goToMealRecord" />

      <view class="record-list" wx:else>
        <view class="record-card record-card--selectable {{item._selected ? 'record-card--selected' : ''}}" wx:for="{{displayRecords}}" wx:key="recordId">
          <app-card>
            <view class="meal-record" bindtap="{{selectMode ? 'onToggleItem' : 'onMealRecordTap'}}" data-id="{{item.recordId}}">
              <text class="select-box {{item._selected ? 'select-box--checked' : ''}}" wx:if="{{selectMode}}">{{item._selected ? '✓' : ''}}</text>
              <text class="record-mark record-mark--meal">{{item.mealTypeMark}}</text>
              <view class="record-main">
                <view class="record-title-row"><text class="record-title">{{item._titleText}}</text><text class="meal-type">{{item.mealTypeText}}</text></view>
                <text class="record-meta">{{item._timeText}} · 共 {{item._totalCount}} 份</text>
                <text class="record-items" wx:if="{{item._itemsText}}">{{item._itemsText}}</text>
              </view>
              <text class="record-arrow" wx:if="{{!selectMode}}">›</text>
            </view>
          </app-card>
        </view>
        <view class="load-more" wx:if="{{!selectMode}}">{{loadingMore ? '正在加载更多…' : (hasMore ? '继续上滑加载更多' : '已加载全部记录')}}</view>
      </view>
    </block>
  </block>

  <view class="batch-bar" wx:if="{{selectMode}}">
    <button class="batch-delete" disabled="{{selectedRecordIds.length === 0 || batchPending}}" bindtap="onBatchDelete">{{batchPending ? '正在删除…' : '删除所选（' + selectedRecordIds.length + '）'}}</button>
  </view>
</view>
