<view class="orders-page">
  <view class="page-state" wx:if="{{loadStatus === 'loading'}}">正在加载饮食记录...</view>
  <view class="page-state" wx:elif="{{loadStatus === 'error'}}"><text>饮食记录加载失败</text><button class="retry-btn" bindtap="onRetryLoad">重新加载</button></view>
  <block wx:else>
  <!-- 统计卡片 -->
  <view class="stats-card" wx:if="{{!selectMode}}">
    <view class="stat-item">
      <text class="stat-num">{{summary.total}}</text>
      <text class="stat-label">总记录</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num done-num">{{summary.completedCount}}</text>
      <text class="stat-label">已记录</text>
    </view>
  </view>

  <view class="calendar-card" wx:if="{{!selectMode}}">
    <view class="calendar-header">
      <text class="month-change" bindtap="onPreviousMonth">‹</text>
      <text class="month-title">{{monthTitle}}</text>
      <text class="month-change" bindtap="onNextMonth">›</text>
    </view>
    <view class="week-row"><text wx:for="{{weekDays}}" wx:key="*this">{{item}}</text></view>
    <view class="day-grid">
      <view class="day-cell {{item.hasRecord ? 'has-record' : ''}} {{item.hasLifeRecord ? 'has-life-record' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}" wx:for="{{calendarDays}}" wx:key="key" bindtap="onCalendarDateTap" data-date="{{item.date}}">
        <text>{{item.day}}</text>
      </view>
    </view>
    <view class="calendar-footer"><text>{{calendarHint}}</text><text wx:if="{{selectedDate}}" bindtap="onClearDate">查看全部</text></view>
  </view>

  <view class="life-record-card" wx:if="{{selectedLifeRecords.length > 0}}">
    <text class="life-record-title">📝 当天完成的生活清单</text>
    <view class="life-record-item" wx:for="{{selectedLifeRecords}}" wx:key="id" bindtap="onLifeRecordTap" data-id="{{item.id}}"><text>{{item.title}}</text><text>查看 ›</text></view>
  </view>

  <view class="quick-meal-entry" wx:if="{{!selectMode}}" bindtap="goToMealRecord"><view><text class="quick-meal-title">＋ 快速记录一餐</text><text class="quick-meal-tip">外出吃或点外卖，简单记下就好</text></view><text class="quick-meal-arrow">›</text></view>

  <!-- 选择模式顶部栏 -->
  <view class="select-bar" wx:if="{{selectMode}}">
    <view class="select-left">
      <view class="checkbox-wrap {{isAllSelected ? 'checked' : ''}}" bindtap="onToggleSelectAll">
        <text class="{{isAllSelected ? 'check-icon' : 'uncheck-icon'}}">{{isAllSelected ? '✓' : '○'}}</text>
        <text class="select-all-text">全选</text>
      </view>
      <text class="select-count">已选 {{selectedIds.length}} 项</text>
    </view>
    <text class="cancel-select" bindtap="onCancelSelect">取消</text>
  </view>

  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-list {{selectMode ? 'in-select-mode' : ''}}" enhanced show-scrollbar="{{false}}">
    <!-- 空状态 -->
    <view class="empty-orders" wx:if="{{displayOrders.length === 0}}">
      <text class="empty-icon-2">📋</text>
      <text class="empty-text-2">{{selectedDate ? '当天暂无饮食记录' : '暂无饮食记录'}}</text>
      <text class="empty-sub-2">去挑选今天想做的菜吧~</text>
    </view>

    <!-- 订单卡片 -->
    <view
      class="order-card {{item._selected ? 'card-selected' : ''}} {{selectMode ? 'card-selectable' : ''}}"
      wx:for="{{displayOrders}}"
      wx:key="orderId"
      bindlongpress="onLongPressCard"
      data-id="{{item.orderId}}"
    >
      <!-- 选择模式下的复选框 -->
      <view class="card-checkbox-area" wx:if="{{selectMode}}" catchtap="onToggleItem" data-id="{{item.orderId}}">
        <view class="checkbox-box {{item._selected ? 'checked' : ''}}">
          <text>{{item._selected ? '✓' : ''}}</text>
        </view>
      </view>

      <!-- 卡片主体（非选择模式下点击进入详情） -->
      <view class="oc-body" bindtap="{{selectMode ? 'onToggleItem' : 'onOrderTap'}}" data-id="{{item.orderId}}">
        <view class="oc-header">
          <view class="oc-left">
            <text class="oc-id">{{item.venue || item.orderId}}</text>
            <text class="oc-time">{{item._timeText}}</text>
          </view>
          <view class="oc-status completed">{{item.mealTypeIcon}} {{item.mealTypeText}}</view>
        </view>

        <!-- 商品摘要行 -->
        <view class="oc-items">
          <view class="oc-item-row" wx:for="{{item.items}}" wx:for-item="food" wx:for-index="fidx" wx:key="id">
            <image class="oci-img" wx:if="{{food.image}}" src="{{food.image}}" mode="aspectFill" lazy-load />
            <text class="oci-icon" wx:else>{{item.mealTypeIcon}}</text>
            <text class="oci-name">{{food.name}}</text>
            <text class="oci-qty">x{{food.quantity}}</text>
          </view>
        </view>

        <view class="oc-footer">
          <text class="oc-count">共 {{item.totalCount}} 份</text>
          <view class="oc-footer-right">
            <text class="oc-delete-btn" catchtap="onDeleteOrder" data-id="{{item.orderId}}" wx:if="{{!selectMode}}">删除</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 批量操作底部栏 -->
  <view class="batch-bar" wx:if="{{selectMode && selectedIds.length > 0}}">
    <view class="batch-btn batch-delete" bindtap="onBatchDelete">
      🗑 批量删除 ({{selectedIds.length}})
    </view>
  </view>

  <view class="bottom-space {{selectMode ? 'with-batch' : ''}}"></view>
  </block>
</view>
