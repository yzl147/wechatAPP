.orders-page {
  min-height: 100vh;
  background-color: #f5f6fa;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 20rpx;
  padding: 28rpx 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a2e;
}

.pending-num { color: #ff6b35; }
.done-num { color: #26de81; }
.amount-num { font-size: 28rpx; }

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background: #eee;
}

.calendar-card { margin: 0 20rpx 18rpx; padding: 18rpx 16rpx 14rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 3rpx 14rpx rgba(0, 0, 0, 0.03); }.calendar-header { display: flex; align-items: center; justify-content: space-between; padding: 0 12rpx 12rpx; }.month-title { font-size: 28rpx; font-weight: 700; color: #333; }.month-change { width: 52rpx; text-align: center; color: #ff6b35; font-size: 42rpx; line-height: 1; }.week-row, .day-grid { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; }.week-row text { padding: 8rpx 0; font-size: 21rpx; color: #aaa; }.day-cell { position: relative; display: flex; align-items: center; justify-content: center; height: 54rpx; margin: 3rpx; border-radius: 50%; font-size: 23rpx; color: #555; }.day-cell.has-record { color: #fff; background: #ff8a5c; }.day-cell.has-life-record { border: 2rpx solid #5b8ec9; }.day-cell.selected { background: #ff5b2d; box-shadow: 0 2rpx 8rpx rgba(255,91,45,.3); }.day-cell.today { border: 1rpx solid #ff6b35; }.calendar-footer { display: flex; justify-content: space-between; margin-top: 12rpx; padding: 10rpx 8rpx 0; border-top: 1rpx solid #f3f3f3; color: #aaa; font-size: 21rpx; }.calendar-footer text:last-child { color: #ff6b35; }.life-record-card { margin: -4rpx 20rpx 14rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: #eef5ff; }.life-record-title { display: block; margin-bottom: 8rpx; color: #4e7199; font-size: 25rpx; font-weight: 600; }.life-record-item { display: flex; justify-content: space-between; padding: 8rpx 0; color: #6c7f94; font-size: 23rpx; }

/* Tab 切换 */
.tabs {
  display: flex;
  padding: 0 32rpx;
  gap: 24rpx;
}

.tab-item {
  font-size: 28rpx;
  color: #999;
  padding-bottom: 16rpx;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #ff6b35, #ff4500);
  border-radius: 3rpx;
}

/* 选择模式顶部栏 */
.select-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  position: sticky;
  top: 0;
  z-index: 10;
}

.select-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 30rpx;
}

.check-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  background: #fff;
  color: #667eea;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
}

.uncheck-icon {
  font-size: 34rpx;
  color: rgba(255,255,255,0.7);
}

.select-all-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.checkbox-wrap.checked .select-all-text { opacity: 1; }

.select-count {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.cancel-select {
  font-size: 26rpx;
  color: #fff;
  padding: 8rpx 24rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 30rpx;
}

/* 订单列表 */
.order-list {
  height: calc(100vh - 680rpx);
  padding: 0 20rpx;
}

.order-list.in-select-mode {
  height: calc(100vh - 300rpx);
}

/* 空状态 */
.empty-orders {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon-2 {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-text-2 {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.empty-sub-2 {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  display: flex;
  transition: all 0.15s ease;
  position: relative;
  overflow: hidden;
}

/* 选择模式下可点击的卡片 */
.order-card.card-selectable::before {
  content: '长按选择';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: rgba(102,126,234,0.25);
  letter-spacing: 2rpx;
  pointer-events: none;
  z-index: 0;
  opacity: 0;
  transition: opacity 0.2s;
}

.order-card.card-selected {
  background: #f0eeff;
  box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.18);
  border: 2rpx solid rgba(102,126,234,0.5);
}

/* 复选框区域 */
.card-checkbox-area {
  display: flex;
  align-items: center;
  padding-right: 14rpx;
  flex-shrink: 0;
  z-index: 1;
}

.checkbox-box {
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  font-size: 24rpx;
  color: transparent;
  transition: all 0.15s ease;
}

.checkbox-box.checked {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-color: #667eea;
  color: #fff;
  font-weight: bold;
}

.oc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  z-index: 1;
  position: relative;
}

.oc-left {
  display: flex;
  flex-direction: column;
}

.oc-id {
  font-size: 24rpx;
  color: #888;
  font-family: monospace;
}

.oc-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.oc-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.oc-status.pending {
  background: #fff3e0;
  color: #e65100;
}

.oc-status.completed {
  background: #e8f5e9;
  color: #2e7d32;
}

/* 商品摘要 */
.oc-items {
  background: #fafafa;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  z-index: 1;
  position: relative;
}

.oc-item-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.oci-img {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.oci-name {
  flex: 1;
  font-size: 26rpx;
  color: #555;
}

.oci-qty {
  font-size: 24rpx;
  color: #999;
}

/* 底部信息 */
.oc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 14rpx;
  z-index: 1;
  position: relative;
}

.oc-footer-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.oc-count {
  font-size: 24rpx;
  color: #999;
}

.oc-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6b35;
}

/* 内联删除小按钮 */
.oc-delete-btn {
  font-size: 22rpx;
  color: #e74c3c;
  padding: 4rpx 14rpx;
  border: 1rpx solid #f5c6cb;
  border-radius: 20rpx;
  background: #fef5f5;
}
.oc-body {
  padding-bottom: 8rpx;
  flex: 1;
  z-index: 1;
  position: relative;
}

/* 批量操作底部栏 */
.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.batch-btn {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  padding: 22rpx 40rpx;
  border-radius: 44rpx;
  color: #fff;
  min-width: 280rpx;
}

.batch-complete {
  background: linear-gradient(135deg, #26de81, #20bf6b);
}

.batch-delete {
  background: linear-gradient(135deg, #ff6b6b, #e74c3c);
}

.bottom-space {
  height: 0;
}

.bottom-space.with-batch {
  height: 0;
}
