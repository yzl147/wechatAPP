.records-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-lg) var(--space-page) calc(var(--space-xl) + env(safe-area-inset-bottom));
  background: var(--color-background);
}
.records-page--managing { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.page-intro, .quick-entry, .calendar-section, .record-section, .record-list { margin-bottom: var(--space-md); }
.page-title, .page-description, .section-title, .section-description, .subsection-title,
.record-title, .record-meta, .record-items, .quick-entry__title, .quick-entry__description { display: block; }
.page-title { color: var(--color-text-primary); font-size: var(--font-page-title); font-weight: 700; }
.page-description { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-body); line-height: 1.55; }

.view-switch {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-xs);
  margin-bottom: var(--space-md);
  padding: 6rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: #eceef1;
}
.view-switch__item {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}
.view-switch__item--active {
  background: var(--color-surface);
  box-shadow: 0 2rpx 8rpx rgba(32, 37, 45, 0.08);
  color: var(--color-text-primary);
  font-weight: 700;
}

.quick-entry__content, .calendar-header, .calendar-footer, .day-heading, .list-toolbar,
.select-bar, .life-record, .meal-record, .record-title-row { display: flex; align-items: center; }
.quick-entry__content, .calendar-header, .calendar-footer, .day-heading, .list-toolbar, .select-bar { justify-content: space-between; }
.quick-entry__title { color: var(--color-meal); font-size: var(--font-section-title); font-weight: 700; }
.quick-entry__description { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); line-height: 1.45; }
.quick-entry__action, .manage-action, .trash-action, .today-action, .cancel-action {
  display: flex;
  min-width: var(--tap-min-size);
  min-height: var(--tap-min-size);
  align-items: center;
  justify-content: flex-end;
  color: var(--color-primary);
  font-size: var(--font-body);
  font-weight: 600;
}
.list-toolbar__actions { display: flex; align-items: center; gap: var(--space-sm); }
.trash-action { color: var(--color-text-secondary); }

.month-action {
  display: flex;
  width: var(--tap-min-size);
  height: var(--tap-min-size);
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  font-size: 48rpx;
}
.month-action--disabled { color: var(--color-text-disabled); }
.month-title { color: var(--color-text-primary); font-size: var(--font-section-title); font-weight: 700; }
.week-row, .day-grid { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; }
.week-row text { padding: var(--space-xs) 0; color: var(--color-text-muted); font-size: 22rpx; }
.day-cell {
  box-sizing: border-box;
  display: flex;
  min-height: 82rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 2rpx;
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm);
  color: var(--color-text-primary);
}
.day-cell--selected { border-color: var(--color-primary); background: var(--color-meal-soft); }
.day-cell--today .day-number { color: var(--color-primary); font-weight: 800; text-decoration: underline; text-underline-offset: 5rpx; }
.day-cell--empty { pointer-events: none; }
.day-number { min-height: 30rpx; font-size: 24rpx; }
.day-markers { display: flex; min-height: 25rpx; align-items: center; gap: 3rpx; margin-top: 3rpx; }
.day-marker, .legend-item { border-radius: 5rpx; font-size: 16rpx; line-height: 23rpx; }
.day-marker { width: 23rpx; height: 23rpx; color: #fff; text-align: center; }
.day-marker--meal { background: var(--color-meal); }
.day-marker--life { background: var(--color-life); }
.calendar-footer { min-height: var(--tap-min-size); margin-top: var(--space-sm); border-top: 1rpx solid var(--color-border); }
.calendar-legend { display: flex; gap: var(--space-sm); }
.legend-item { padding: 4rpx 8rpx; font-size: 20rpx; }
.legend-item--meal { background: var(--color-meal-soft); color: var(--color-meal); }
.legend-item--life { background: var(--color-life-soft); color: var(--color-life); }

.day-heading, .list-toolbar { min-height: var(--tap-min-size); margin-top: var(--space-sm); }
.section-title { color: var(--color-text-primary); font-size: var(--font-section-title); font-weight: 700; }
.section-description { margin-top: 5rpx; color: var(--color-text-muted); font-size: var(--font-caption); }
.subsection-title { margin-bottom: var(--space-sm); color: var(--color-text-secondary); font-size: var(--font-body); font-weight: 700; }
.record-card { margin-bottom: var(--space-sm); }
.record-card--selected { border-radius: var(--radius-card); outline: 3rpx solid rgba(244, 91, 42, 0.35); }
.life-record, .meal-record { min-height: var(--tap-min-size); }
.record-mark {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.record-mark--meal { background: var(--color-meal); }
.record-mark--life { background: var(--color-life); }
.record-main { min-width: 0; flex: 1; }
.record-title-row { gap: var(--space-sm); }
.record-title {
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meal-type { flex-shrink: 0; padding: 3rpx 9rpx; border-radius: 8rpx; background: var(--color-meal-soft); color: var(--color-meal); font-size: 20rpx; }
.record-meta, .record-items {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: var(--font-caption);
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-items { color: var(--color-text-secondary); }
.record-arrow { margin-left: var(--space-sm); color: var(--color-text-disabled); font-size: 38rpx; }

.select-bar {
  min-height: var(--tap-min-size);
  margin-bottom: var(--space-md);
  padding: 0 var(--space-sm);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}
.select-action { display: flex; min-height: var(--tap-min-size); align-items: center; gap: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-body); }
.select-box {
  box-sizing: border-box;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  border: 2rpx solid var(--color-text-disabled);
  border-radius: 50%;
  color: #fff;
  font-size: 23rpx;
}
.select-box--checked { border-color: var(--color-primary); background: var(--color-primary); }
.selected-count { color: var(--color-text-muted); font-size: var(--font-caption); }
.load-more { padding: var(--space-md) 0 var(--space-xl); color: var(--color-text-muted); font-size: var(--font-caption); text-align: center; }

.batch-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: var(--space-sm) var(--space-page) calc(var(--space-sm) + env(safe-area-inset-bottom));
  background: var(--color-surface);
  box-shadow: var(--shadow-floating);
}
.batch-delete {
  height: var(--tap-min-size);
  border-radius: 44rpx;
  background: var(--color-danger);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: var(--tap-min-size);
}
.batch-delete[disabled] { background: var(--color-text-disabled); color: #fff; }
.batch-delete::after { border: 0; }
