.error-state { display: flex; min-height: 240rpx; flex-direction: column; align-items: center; justify-content: center; color: var(--color-danger); text-align: center; }
.error-state--compact { min-height: var(--tap-min-size); flex-direction: row; justify-content: flex-start; gap: var(--space-sm); text-align: left; }
.error-copy { min-width: 0; }
.error-title { display: block; font-size: var(--font-body); font-weight: 600; }
.error-description { display: block; margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); }
.error-action { display: flex; min-width: var(--tap-min-size); min-height: var(--tap-min-size); box-sizing: border-box; align-items: center; justify-content: center; margin-top: var(--space-sm); padding: 0 var(--space-sm); border: 1rpx solid rgba(196, 61, 56, 0.26); border-radius: var(--radius-sm); background: rgba(196, 61, 56, 0.06); color: var(--color-danger); font-size: var(--font-caption); }
.error-state--compact .error-title { font-size: var(--font-caption); }
.error-state--compact .error-action { margin-top: 0; }
