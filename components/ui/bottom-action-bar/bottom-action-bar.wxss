.bottom-action-bar { position: fixed; z-index: 100; right: 0; bottom: 0; left: 0; display: flex; min-height: 112rpx; align-items: center; justify-content: space-between; gap: var(--space-md); box-sizing: border-box; padding: var(--space-sm) var(--space-page) calc(var(--space-sm) + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, 0.98); box-shadow: var(--shadow-floating); }
.action-summary { flex-shrink: 0; color: var(--color-text-secondary); font-size: var(--font-caption); }
.action-buttons { display: flex; min-width: 0; flex: 1; justify-content: flex-end; gap: var(--space-sm); }
.primary-action, .secondary-action { display: flex; min-height: var(--tap-min-size); align-items: center; justify-content: center; box-sizing: border-box; padding: 0 var(--space-md); border-radius: var(--radius-sm); font-size: var(--font-body); font-weight: 700; text-align: center; }
.primary-action { min-width: 236rpx; background: var(--color-primary); color: #fff; }
.primary-action--disabled { background: var(--color-text-disabled); }
.secondary-action { border: 2rpx solid var(--color-border); background: var(--color-surface); color: var(--color-text-secondary); }
