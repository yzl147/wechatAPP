.roulette-container { display: flex; width: 100%; justify-content: center; padding: var(--space-sm) 0; }
.roulette-shell { position: relative; width: 560rpx; height: 560rpx; max-width: calc(100vw - 96rpx); max-height: calc(100vw - 96rpx); }
.roulette-motion { width: 100%; height: 100%; overflow: hidden; border-radius: 50%; box-shadow: var(--shadow-card); transition-property: transform; transition-timing-function: cubic-bezier(0.12, 0.72, 0.08, 1); }
.roulette-canvas { display: block; width: 100%; height: 100%; }
.roulette-pointer { position: absolute; z-index: 3; top: -10rpx; left: 50%; width: 0; height: 0; border-right: 24rpx solid transparent; border-left: 24rpx solid transparent; border-top: 58rpx solid var(--color-text-primary); filter: drop-shadow(0 4rpx 5rpx rgba(40, 40, 50, 0.18)); transform: translateX(-50%); }
.roulette-center { position: absolute; z-index: 2; top: 50%; left: 50%; display: flex; box-sizing: border-box; width: 120rpx; height: 120rpx; align-items: center; justify-content: center; padding: var(--space-xs); border: 8rpx solid rgba(255, 255, 255, 0.9); border-radius: 50%; background: var(--color-surface); box-shadow: 0 4rpx 14rpx rgba(40, 40, 50, 0.18); color: var(--color-text-primary); font-size: var(--font-caption); font-weight: 700; text-align: center; transform: translate(-50%, -50%); }
.roulette-center--spinning { color: var(--color-primary); }
.roulette-empty { display: flex; box-sizing: border-box; width: 560rpx; height: 560rpx; max-width: calc(100vw - 96rpx); max-height: calc(100vw - 96rpx); align-items: center; justify-content: center; border: 2rpx dashed var(--color-border); border-radius: 50%; background: var(--color-surface); color: var(--color-text-muted); font-size: var(--font-body); }
