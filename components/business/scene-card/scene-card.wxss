.scene-layout { display: flex; min-height: 112rpx; align-items: center; }
.scene-symbol { display: flex; width: var(--tap-min-size); height: var(--tap-min-size); flex-shrink: 0; align-items: center; justify-content: center; border-radius: var(--radius-emphasis); background: rgba(255, 255, 255, 0.82); color: var(--color-text-primary); font-size: var(--font-section-title); font-weight: 700; }
.scene-symbol--meal { color: var(--color-meal); }
.scene-symbol--life { color: var(--color-life); }
.scene-content { min-width: 0; flex: 1; margin-left: var(--space-md); }
.scene-title { display: block; color: var(--color-text-primary); font-size: var(--font-card-title); font-weight: 700; }
.scene-description { display: block; margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-caption); line-height: 1.5; }
.scene-status { display: block; margin-top: var(--space-sm); color: var(--color-primary); font-size: var(--font-caption); font-weight: 500; }
.scene-status--life { color: var(--color-life); }
.scene-arrow { display: flex; min-width: var(--tap-min-size); min-height: var(--tap-min-size); align-items: center; justify-content: flex-end; color: var(--color-text-muted); font-size: 48rpx; }
